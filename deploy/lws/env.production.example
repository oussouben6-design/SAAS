# =====================================================================
# Excellence 360 CRM — variables de production sur LWS (Cloud KVM / VPS)
#
# Emplacement : /var/www/excellence360/.env.production
# Droits      : chown excellence360:excellence360 · chmod 600
# Ne jamais committer ce fichier : il contient les secrets de production.
#
# Après toute modification : `pm2 reload excellence360-crm --update-env`
# (les variables sont lues au démarrage du processus).
# =====================================================================

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------
# Adresse publique — pilote les liens d'e-mail, OAuth et le référencement
# ---------------------------------------------------------------------
APP_URL=https://360crm.excellence-services-sarl.com
NEXT_PUBLIC_SITE_URL=https://360crm.excellence-services-sarl.com

# ---------------------------------------------------------------------
# Base de données : Supabase (pooler port 6543, IPv4)
# ---------------------------------------------------------------------
DATABASE_MODE=postgres
DATABASE_URL=postgresql://postgres.opnlvqwbevnivfjpbrxa:MOT_DE_PASSE_DB@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5
DATABASE_SSL=true
# Le schéma est déjà appliqué : ne pas migrer à chaque redémarrage.
AUTO_MIGRATE=false

# ---------------------------------------------------------------------
# Stockage des documents : bucket privé Supabase
# ---------------------------------------------------------------------
STORAGE_DRIVER=supabase
SUPABASE_URL=https://opnlvqwbevnivfjpbrxa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
# Serveur dédié (pas de limite serverless) : 10 Mio, comme en développement.
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------
# E-mails — Resend obligatoire tant que le code de connexion OTP est actif
# ---------------------------------------------------------------------
MAIL_TRANSPORT=resend
RESEND_API_KEY=
MAIL_FROM=Excellence 360 CRM <no-reply@excellence-services-sarl.com>
AUTH_LOGIN_OTP=true
AUTH_LOGIN_OTP_GOOGLE=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_ALLOW_REGISTRATION=false

# ---------------------------------------------------------------------
# Clés générées une seule fois, puis conservées
#   MFA_ENCRYPTION_KEY : openssl rand -base64 32
#   MAINTENANCE_SECRET : openssl rand -hex 32
# ---------------------------------------------------------------------
MFA_ENCRYPTION_KEY=
MAINTENANCE_SECRET=

# ---------------------------------------------------------------------
# Connexion Google — URI de redirection à déclarer dans Google Cloud :
#   https://360crm.excellence-services-sarl.com/api/auth/google/callback
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Référencement
# ---------------------------------------------------------------------
# Jeton de vérification Google Search Console (méthode « balise HTML »).
# Laisser vide tant que la propriété n'est pas créée : la balise est alors absente.
GOOGLE_SITE_VERIFICATION=
# Accès direct sans compte — réservé à un déploiement strictement privé.
# PERSONAL_MODE=true
