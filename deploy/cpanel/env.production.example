# =====================================================================
# Excellence 360 CRM — variables de production sur cPanel LWS
#
# Emplacement : <dossier de l'application>/.env.production
#   cp deploy/cpanel/env.production.example .env.production
#   nano .env.production
#   chmod 600 .env.production
#
# Ce fichier est lu DEUX fois :
#   · au build (`npm run build`), par Next.js et par `npm run env:check` ;
#   · au démarrage, par passenger.cjs (qui charge lui-même .env.production).
# Après toute modification :
#   touch tmp/restart.txt          (Passenger relance l'application)
#   npm run build                  (si une variable NEXT_PUBLIC_* a changé)
#
# Ne jamais committer ce fichier : il contient les secrets de production.
# =====================================================================

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------
# Adresse publique — pilote les liens d'e-mail, OAuth et le référencement
# ---------------------------------------------------------------------
# Le sous-domaine cPanel, en HTTPS, sans slash final.
APP_URL=https://360crm.excellence-services-sarl.com
NEXT_PUBLIC_SITE_URL=https://360crm.excellence-services-sarl.com

# ---------------------------------------------------------------------
# Base de données : Supabase (pooler port 6543, IPv4)
# ---------------------------------------------------------------------
DATABASE_MODE=postgres
DATABASE_URL=postgresql://postgres.opnlvqwbevnivfjpbrxa:MOT_DE_PASSE_DB@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5
DATABASE_SSL=true
# Le schéma est déjà appliqué (26 migrations) : ne pas migrer à chaque redémarrage.
AUTO_MIGRATE=false

# ---------------------------------------------------------------------
# Stockage des documents : bucket privé Supabase
# ---------------------------------------------------------------------
# Le disque cPanel est persistant, mais le stockage local n'est PAS recommandé :
# il ne survit pas à une migration d'hébergement et n'est pas sauvegardé par
# Supabase. Le bucket privé reste la source de vérité.
STORAGE_DRIVER=supabase
SUPABASE_URL=https://opnlvqwbevnivfjpbrxa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
# Hébergement mutualisé : pas de limite serverless, mais restez raisonnable
# (un envoi de 10 Mio consomme la mémoire et le temps CPU du compte).
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------
# E-mails — Resend obligatoire tant que le code de connexion OTP est actif
# ---------------------------------------------------------------------
MAIL_TRANSPORT=resend
RESEND_API_KEY=
MAIL_FROM=Excellence 360 CRM <no-reply@excellence-services-sarl.com>
AUTH_LOGIN_OTP=true
AUTH_LOGIN_OTP_GOOGLE=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_ALLOW_REGISTRATION=false

# ---------------------------------------------------------------------
# Clés générées une seule fois, puis conservées hors ligne
#   MFA_ENCRYPTION_KEY : openssl rand -base64 32
#   MAINTENANCE_SECRET : openssl rand -hex 32
# ---------------------------------------------------------------------
MFA_ENCRYPTION_KEY=
MAINTENANCE_SECRET=

# ---------------------------------------------------------------------
# Connexion Google — URI de redirection à déclarer dans Google Cloud :
#   https://360crm.excellence-services-sarl.com/api/auth/google/callback
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Référencement
# ---------------------------------------------------------------------
# Jeton de vérification Google Search Console (méthode « balise HTML »).
# Laisser vide tant que la propriété n'est pas créée : la balise est alors absente.
GOOGLE_SITE_VERIFICATION=

# Accès direct sans compte — réservé à un déploiement strictement privé.
# PERSONAL_MODE=true
