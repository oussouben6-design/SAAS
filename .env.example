# =====================================================================
# Excellence 360 CRM — variables d'environnement (exemple, sans aucun secret)
# Copiez ce fichier en `.env.local` (développement) ou configurez les
# mêmes clés dans votre hébergeur (production). Ne committez jamais
# de valeur réelle dans ce fichier.
# =====================================================================

# ---------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------
# `pglite`    : PostgreSQL embarqué (WASM), aucun service externe requis.
#               Recommandé pour le développement et une démonstration locale.
# `postgres`  : connexion à un PostgreSQL réseau (Supabase ou auto-hébergé).
#               Les mêmes migrations supabase/migrations/*.sql sont appliquées.
DATABASE_MODE=pglite

# Requis si DATABASE_MODE=postgres.
# Supabase : Project Settings → Database → Connection string → « Transaction pooler ».
# IMPORTANT : utilisez le POOLER (port 6543, IPv4). La connexion directe
# (db.<ref>.supabase.co:5432) est IPv6 uniquement et injoignable depuis la plupart des hébergeurs.
# Le rôle `postgres` de Supabase contourne la RLS (BYPASSRLS) : c'est lui qui exécute les
# migrations et le service d'authentification, puis bascule en `set local role organix_app`
# pour les requêtes métier (migration 0012). Utilisez un pool de connexions faible (DATABASE_POOL_MAX).
# Exemple : postgresql://postgres.opnlvqwbevnivfjpbrxa:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Nombre maximal de connexions du pool (2 à 5 suffisent avec un pooler).
DATABASE_POOL_MAX=5

# `false` pour désactiver TLS (PostgreSQL local uniquement).
DATABASE_SSL=true

# Applique automatiquement les migrations au démarrage (utile en CI/production).
# En développement PGlite, les migrations sont toujours appliquées au premier accès.
AUTO_MIGRATE=false

# Répertoire de la base embarquée (ignoré par Git).
ORGANIX_DATA_DIR=.data/pglite

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
# URL publique utilisée dans les liens d'e-mail et les redirections.
# Sur Vercel : VERCEL_PROJECT_PRODUCTION_URL est utilisée automatiquement si APP_URL est absente
# (VERCEL_URL en dehors de la production). Sur Netlify : URL / DEPLOY_PRIME_URL. Sans effet en local.
APP_URL=http://localhost:3000

# Autoriser la création libre de compte (false = invitation uniquement).
AUTH_ALLOW_REGISTRATION=true

# Exiger une adresse e-mail vérifiée pour se connecter.
# À laisser sur false tant qu'aucun transport d'e-mail n'est configuré.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------
# Code de connexion par e-mail (OTP) — actif par défaut
# ---------------------------------------------------------------------
# À CHAQUE connexion (mot de passe, ou retour Google), un code à 6 chiffres est
# envoyé à l'adresse du compte ; il est exigé avant l'ouverture de session.
#  - en développement (MAIL_TRANSPORT=console), aucun e-mail ne part : le code
#    est affiché à l'écran après connexion ;
#  - en production, MAIL_TRANSPORT=resend + RESEND_API_KEY sont exigés
#    (npm run env:check refuse le déploiement sinon) ;
#  - AUTH_LOGIN_OTP=false désactive ce second verrou — uniquement en dernier
#    recours (incident, urgence) et temporairement.
#  - Après une connexion Google, le code n'est PAS exigé par défaut (le jeton
#    d'identité Google prouve l'adresse : connexion « en un clic ») ; posez
#    AUTH_LOGIN_OTP_GOOGLE=true pour l'exiger aussi après Google.
AUTH_LOGIN_OTP=true
AUTH_LOGIN_OTP_GOOGLE=false

# ---------------------------------------------------------------------
# Connexion avec Google (OAuth 2.0 / OpenID Connect) — optionnel
# ---------------------------------------------------------------------
# Identifiants à créer dans Google Cloud Console (gratuit) :
#   APIs et services → Identifiants → Créer → ID client OAuth → « Application Web ».
# URI de redirection autorisée à déclarer (doit correspondre EXACTEMENT) :
#   <APP_URL>/api/auth/google/callback      (ex. http://localhost:3000/api/auth/google/callback)
# Laissez vide pour masquer le bouton « Continuer avec Google ».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret de la maintenance planifiée (/api/maintenance) : purge des sessions expirées.
# Générer avec `openssl rand -hex 32`. Vide = route désactivée (503) ; aucun accès anonyme.
# Côté hébergeur : planifier un appel POST quotidien (GitHub Actions, Vercel Cron,
# Netlify Scheduled Function — voir .github/workflows/cron.yml).
MAINTENANCE_SECRET=

# ---------------------------------------------------------------------
# Double authentification (TOTP)
# ---------------------------------------------------------------------
# Clé AES-256-GCM (32 octets, base64) qui chiffre les secrets TOTP en base.
# Générez-la une seule fois : openssl rand -base64 32
# Laissez vide pour désactiver la fonctionnalité (l'activation est alors refusée).
# ATTENTION : changer cette clé rend les secrets existants illisibles — les
# utilisateurs concernés devront réenregistrer leur application d'authentification.
MFA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# E-mails transactionnels
# ---------------------------------------------------------------------
# Valeurs possibles : console | none | smtp | resend
# `console`  : journalise le lien côté serveur et l'affiche en développement.
# `resend`   : envoi réel via l'API HTTP Resend (RESEND_API_KEY + MAIL_FROM requis).
# `smtp`     : non implémenté — l'application refuse explicitement (aucun faux succès).
MAIL_TRANSPORT=console
MAIL_FROM=

# Requis si MAIL_TRANSPORT=resend (clé API du compte Resend, plan gratuit suffisant).
RESEND_API_KEY=

# ---------------------------------------------------------------------
# Stockage des documents
# ---------------------------------------------------------------------
# Valeurs possibles : local | supabase
# `supabase` : bucket privé Supabase Storage via l'API REST (SUPABASE_URL et
#              SUPABASE_SERVICE_ROLE_KEY requis). Les fichiers ne sont jamais publics.
STORAGE_DRIVER=local
SUPABASE_STORAGE_BUCKET=documents
ORGANIX_STORAGE_DIR=.data/storage
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------
# Assistant IA (facultatif — intégration NON développée)
# ---------------------------------------------------------------------
# Aucun appel externe n'est effectué, même si une clé est présente.
OPENAI_API_KEY=

# ---------------------------------------------------------------------
# Supabase (uniquement si vous branchez l'authentification/storage Supabase)
# ---------------------------------------------------------------------
# URL du projet, utilisée côté serveur pour le stockage privé.
SUPABASE_URL=
# La clé service_role ne doit JAMAIS être exposée au navigateur ni commitée.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mode personnel (docs/mode-personnel.md) — OPTIONNEL, DANGER sur domaine public
# PERSONAL_MODE=true
# PERSONAL_OWNER_EMAIL=personnel@organix.local
# PERSONAL_OWNER_NAME=Moi
# PERSONAL_ORG_NAME=Mon espace Excellence 360
